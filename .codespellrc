[codespell]
# "crasher" is standard Go fuzzing terminology (a failing input stored under
# testdata/fuzz/) — see go.dev/security/fuzz; not a misspelling of "crash".
# "keep-alives" is the plural noun for SSE keep-alive heartbeats.
ignore-words-list = crasher,keep-alives
# Vendored upstream DataStar client bundle: minified JS trips the dictionary
# constantly ("ue", "te", "ot") and must never be edited anyway.
# Patterns must be walk-mode globs: directory scans match "./"-prefixed
# paths, so a bare "static/datastar.js" pattern never fires there (verified
# with codespell 2.4.3: exact pattern 32 hits, "*/…" wildcard 0).
skip = */datastar.js,*/vendor/*
